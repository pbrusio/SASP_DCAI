name: "ise-dfp"
platform: "onnxruntime_onnx"
max_batch_size: 64

input [{
  name: "input"
  data_type: TYPE_FP32
  dims: [14]
}]

output [{
  name: "output"
  data_type: TYPE_FP32
  dims: [14]
}]

dynamic_batching {
  preferred_batch_size: [8, 16, 32]
  max_queue_delay_microseconds: 100
}

instance_group [{
  count: 1
  kind: KIND_GPU
  gpus: [0]
}]
