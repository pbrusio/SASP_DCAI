# ============================================================================
# SASP Environment Configuration
# Copy to .env and fill in values:  cp .env.example .env
# ============================================================================

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=<S2_IP>:9092        # [REQUIRED] Kafka broker address
KAFKA_TOPIC_NETFLOW=netflow-raw                   # [OPTIONAL] NetFlow ingest topic
KAFKA_TOPIC_SYSLOG=syslog-raw                     # [OPTIONAL] Syslog ingest topic
KAFKA_TOPIC_ISE=ise-raw                           # [OPTIONAL] ISE pxGrid ingest topic
KAFKA_TOPIC_DETECTIONS=morpheus-detections        # [OPTIONAL] Morpheus output topic
KAFKA_CONSUMER_GROUP=sasp-pipeline                # [OPTIONAL] Consumer group ID

# --- Splunk ---
SPLUNK_HEC_URL=https://<SPLUNK_IP>:8088/services/collector/event  # [REQUIRED] HEC endpoint
SPLUNK_HEC_TOKEN=changeme                         # [REQUIRED] HEC authentication token
SPLUNK_INDEX=sasp_detections                      # [OPTIONAL] Target index
SPLUNK_TLS_VERIFY=false                           # [OPTIONAL] Verify TLS certificate

# --- Triton Inference Server ---
TRITON_SERVER_URL=<S1_IP>                    # [REQUIRED] Triton host
TRITON_HTTP_PORT=8000                             # [OPTIONAL] Triton HTTP port
TRITON_GRPC_PORT=8001                             # [OPTIONAL] Triton gRPC port
TRITON_METRICS_PORT=8002                          # [OPTIONAL] Triton metrics port
TRITON_MODEL_REPO=/mnt/storage1/models            # [OPTIONAL] Model repository path

# --- LLM (OpenAI-compatible API) ---
# Works with LM Studio, vLLM, Ollama, or any OpenAI-compatible server.
# FAST = triage/simple tasks; HEAVY = reasoning/report generation
LLM_ENDPOINT_FAST=http://192.168.0.100:1234/v1   # [REQUIRED] Fast model endpoint
LLM_ENDPOINT_HEAVY=http://192.168.0.101:1234/v1  # [REQUIRED] Heavy model endpoint
LLM_API_KEY_FAST=lm-studio                        # [OPTIONAL] API key for fast endpoint
LLM_API_KEY_HEAVY=lm-studio                       # [OPTIONAL] API key for heavy endpoint
LLM_MODEL_FAST=nemotron-mini                      # [OPTIONAL] Model name for fast tasks
LLM_MODEL_HEAVY=nemotron                          # [OPTIONAL] Model name for heavy tasks
LLM_TEMPERATURE_TRIAGE=0.0                        # [OPTIONAL] Triage agent temperature
LLM_TEMPERATURE_INVESTIGATE=0.2                   # [OPTIONAL] Investigation agent temperature
LLM_TEMPERATURE_THREAT_INTEL=0.3                  # [OPTIONAL] Threat intel agent temperature
LLM_TEMPERATURE_REPORT=0.5                        # [OPTIONAL] Report agent temperature
LLM_TIMEOUT=60                                    # [OPTIONAL] LLM request timeout (seconds)

# --- Sanitizer ---
SANITIZER_STRICT_MODE=true                        # [OPTIONAL] Reject (true) vs sanitize (false)
SANITIZER_LOG_ORIGINALS=true                      # [OPTIONAL] Log originals for forensics
SANITIZER_INPUT_TOPICS=netflow-raw,syslog-raw,ise-raw  # [OPTIONAL] Topics to consume
SANITIZER_OUTPUT_SUFFIX=-sanitized                # [OPTIONAL] Suffix for output topics

# --- Network / Servers ---
SERVER1_IP=<S1_IP>                           # [REQUIRED] C220 M5 (inference)
SERVER2_IP=<S2_IP>                           # [REQUIRED] C240 M5 (data/training)
MAC_STUDIO_IP=192.168.0.101                       # [OPTIONAL] Mac Studio (dev/LLM)
RDMA_SUBNET=192.168.10.0/24                       # [OPTIONAL] RoCE v2 subnet
RDMA_IP_SERVER1=192.168.10.34                     # [OPTIONAL] Server 1 RDMA IP
RDMA_IP_SERVER2=192.168.10.32                     # [OPTIONAL] Server 2 RDMA IP

# --- Security ---
AUDIT_LOG_PATH=/var/log/sasp/audit.jsonl          # [OPTIONAL] Audit log file path
HMAC_SIGNING_KEY=changeme                         # [REQUIRED] HMAC key for event signing

# --- UI (Gradio) ---
GRADIO_SERVER_PORT=7860                           # [OPTIONAL] Gradio dashboard port
GRADIO_AUTH_USERNAME=admin                         # [OPTIONAL] Dashboard username
GRADIO_AUTH_PASSWORD=changeme                      # [REQUIRED] Dashboard password
